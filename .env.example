# Telegram delivery. Leave unset to run print-only.
POIDH_RADAR_TG_TOKEN=
POIDH_RADAR_TG_CHAT=

# Optional: where to keep the "already reported" state. Default: ./state.json
# When running in Docker this must be a path inside the container (/app/state.json),
# not the host path, or the file dies with the container.
# POIDH_RADAR_STATE=/app/state.json
